[Unit]
Description=Meshtaa - Meshtastic Auto Answer Daemon
Documentation=man:meshtaa(1)
After=network.target
Wants=network.target

[Service]
Type=simple
User=meshtaa
Group=meshtaa
ExecStart=/usr/local/bin/meshtaa --config /etc/meshtaa/meshtaa.conf
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /var/run
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

# Allow access to serial devices
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target